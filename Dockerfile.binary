# ============================================
# Hirezo 教师管理系统 - 使用预编译二进制的最小镜像
# 不想跑 Docker 构建时，先执行 ./build.sh linux amd64 得到 hirezo-linux-amd64，
# 再把该文件与本文件放到同一目录后执行：
#   docker build -t hirezo -f Dockerfile.binary .
#   docker run -d -p 8080:8080 -v hirezo-data:/data --name hirezo hirezo
# ============================================

# alpine：CA 证书（访问大模型 HTTPS 接口）+ poppler-utils（pdftoppm 识别扫描件）
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata poppler-utils
COPY hirezo-linux-amd64 /hirezo
ENV TZ=Asia/Shanghai
WORKDIR /data
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["/hirezo"]
CMD ["-db", "/data/hirezo.db"]
